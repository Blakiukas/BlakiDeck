<UserControl x:Class="Ekrano_valdymas.HueWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ekrano_valdymas"
             Tag="NoWindowDrag">
    <UserControl.Resources>
        <Style x:Key="HueButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource TekoFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="surface" Property="BorderBrush" Value="#AFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="surface" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="surface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Color samples must retain their real RGB even when editing is unavailable. -->
        <Style x:Key="HueColorSwatch" TargetType="Button" BasedOn="{StaticResource HueButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HueRoomButton" TargetType="Button" BasedOn="{StaticResource HueButton}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="BorderBrush" Value="#32FFFFFF"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <!-- The same geometry and interaction as Spotify's VOL control. -->
        <Style x:Key="HueBrightnessSlider" TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="46" Background="Transparent">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" CornerRadius="2.5" Background="{DynamicResource AccentBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" CornerRadius="2.5" Background="#22FFFFFF"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="31" Height="31" Cursor="Hand" Background="Transparent">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Ellipse Width="24" Height="24" Fill="{DynamicResource SpotifyControlBrush}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HueScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Border Width="5" Background="{TemplateBinding Background}" CornerRadius="2.5"
                                    HorizontalAlignment="Center"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="9" MinHeight="34" Background="Transparent">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#95FFFFFF" CornerRadius="4.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border local:CommonMetal.Surface="True" Background="{DynamicResource PanelMetalBrush}" BorderBrush="#35FFFFFF"
            BorderThickness="1.5" CornerRadius="18" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/><RowDefinition Height="1"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid PreviewMouseRightButtonDown="Header_PreviewMouseRightButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.ColumnSpan="2" Tag="WindowDrag" Background="Transparent"
                      PreviewMouseLeftButtonDown="Header_PreviewMouseLeftButtonDown">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Ellipse Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                <GradientStop Color="#FFFF8A3D" Offset="0"/><GradientStop Color="#FFE640A8" Offset="0.45"/>
                                <GradientStop Color="#FF6D5CFF" Offset="0.72"/><GradientStop Color="#FF42CFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <local:OpticallyCenteredText Grid.Column="1" Tag="ModuleTitle" Text="PHILIPS HUE"
                               TextBrush="{DynamicResource ModuleTitleBrush}" TextFontFamily="{StaticResource TekoFont}"
                               TextFontWeight="Bold" TextFontSize="27" VerticalAlignment="Center"
                               Margin="0,0,8,0" InkAlignment="Left"/>
                </Grid>
                <Button x:Name="allLightsOffButton" Grid.Column="2" VerticalAlignment="Center"
                        Style="{StaticResource ModuleOptionsButtonStyle}" Tag="NoWindowDrag"
                        Width="160" Height="36" Padding="8,0" FontFamily="{StaticResource TekoFont}" FontWeight="Bold" FontSize="19" Visibility="Collapsed"
                        Content="All lights off" ToolTip="Turn selected lights off"
                        Foreground="{DynamicResource PanelTextBrush}"
                        Click="AllLightsOff_Click"/>
                <local:ModuleOptionsButton Grid.Column="3" ToolTip="Edit lights" AutomationProperties.Name="Edit lights"/>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource PanelDividerBrush}"/>
            <Grid x:Name="selectionActions" Grid.Row="2" Margin="0,10,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                <local:OpticallyCenteredText Text="Choose rooms controlled by this dashboard" TextFontFamily="{StaticResource TekoFont}" TextFontSize="22" TextBrush="{DynamicResource PanelTextBrush}" InkAlignment="Left" Ellipsis="True" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Style="{StaticResource HueButton}" Height="36" Margin="0,0,6,0" Padding="4,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Foreground="{DynamicResource PanelTextBrush}" Background="{DynamicResource ModuleCardSurfaceBrush}" Click="CancelRoomSelection_Click">
                    <local:OpticallyCenteredText Text="Cancel" TextFontFamily="{StaticResource TekoFont}" TextFontSize="20.7" TextFontWeight="Bold" TextBrush="{DynamicResource PanelTextBrush}"/>
                </Button>
                <Button x:Name="saveRoomSelectionButton" Grid.Column="2" Style="{StaticResource HueButton}" Height="36" Padding="4,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Foreground="White" Background="{DynamicResource ActionFillBrush}" BorderBrush="{DynamicResource ActionAccentBrush}" Click="EditRoomsButton_Click">
                    <local:OpticallyCenteredText Text="Save" TextFontFamily="{StaticResource TekoFont}" TextFontSize="20.7" TextFontWeight="Bold" TextBrush="White"/>
                </Button>
            </Grid>
            <StackPanel x:Name="setupPanel" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="360">
                <TextBlock x:Name="statusText" Text="No Hue Bridge connected"
                           Foreground="{DynamicResource PanelTextBrush}" FontSize="22" FontWeight="SemiBold"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,18"/>
                <ComboBox x:Name="bridgePicker" Height="48" Margin="0,0,0,12"
                          Visibility="Collapsed" FontSize="17"
                          SelectionChanged="BridgePicker_SelectionChanged"/>
                <Button x:Name="discoverButton" Content="FIND HUE BRIDGE" Height="48"
                        Style="{StaticResource HueButton}" FontSize="24"
                        Foreground="White" Background="{DynamicResource ActionFillBrush}" BorderBrush="{DynamicResource ActionAccentBrush}"
                        BorderThickness="1.5" Click="DiscoverButton_Click"/>
                <Button x:Name="connectButton" Content="RETRY PAIRING" Height="58" Margin="0,12,0,0"
                        Visibility="Collapsed" Style="{StaticResource HueButton}"
                        FontSize="24" Foreground="White"
                        Background="#FF604020" BorderBrush="#A0FF8A00" BorderThickness="1.5"
                        Click="ConnectButton_Click"/>
                <TextBlock x:Name="bridgeAddressText" Foreground="{DynamicResource PanelTextBrush}" FontSize="15"
                           TextAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
            <Grid x:Name="controlsPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,10,0,0"
                  Tag="NoWindowDrag" Stylus.IsPressAndHoldEnabled="False">
                <Grid>
                    <ScrollViewer x:Name="roomsScrollViewer"
                                  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly" PanningDeceleration="0.0015"
                                  IsManipulationEnabled="True" ScrollChanged="RoomsScrollViewer_ScrollChanged"
                                  PreviewTouchDown="RoomsScrollViewer_PreviewTouchDown"
                                  PreviewTouchMove="RoomsScrollViewer_PreviewTouchMove"
                                  PreviewTouchUp="RoomsScrollViewer_PreviewTouchUp">
                        <StackPanel x:Name="roomsPanel" Margin="0,0,0,18"/>
                    </ScrollViewer>
                    <Border x:Name="overflowIndicatorTop" Height="40" VerticalAlignment="Top"
                            IsHitTestVisible="False" Visibility="Collapsed">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F0202020" Offset="0"/><GradientStop Color="#00202020" Offset="1"/></LinearGradientBrush></Border.Background>
                        <Path Data="M0,12 L16,0 L32,12" Width="32" Height="12" Stretch="Uniform" Stroke="White" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="overflowIndicator" Height="40" VerticalAlignment="Bottom"
                            IsHitTestVisible="False" Visibility="Collapsed">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#002C2C2C" Offset="0"/>
                                <GradientStop Color="#F0202020" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="M1,1 L8,8 L15,1" Width="32" Height="18" Stretch="Uniform" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
