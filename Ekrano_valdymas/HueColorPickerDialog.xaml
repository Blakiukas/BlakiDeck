<local:SettingsWindow xmlns:local="clr-namespace:Ekrano_valdymas" x:Class="Ekrano_valdymas.HueColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hue color" Width="460" Height="520" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="ContentTemplateSelector" Value="{StaticResource ButtonTextTemplateSelector}"/>
            <Setter Property="FontFamily" Value="{StaticResource TekoFont}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="surface" Property="BorderBrush" Value="#CFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="surface" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource ModuleBackgroundBrush}" CornerRadius="18" BorderBrush="#35FFFFFF"
            BorderThickness="1.5" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/><RowDefinition Height="1"/>
                <RowDefinition Height="*"/><RowDefinition Height="58"/>
            </Grid.RowDefinitions>
            <DockPanel MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                <Ellipse Width="26" Height="26" Margin="0,0,12,0">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                            <GradientStop Color="#FFFF8A3D"/><GradientStop Color="#FFE640A8" Offset="0.45"/>
                            <GradientStop Color="#FF6D5CFF" Offset="0.72"/><GradientStop Color="#FF42CFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock x:Name="colorHeading" Text="LIGHT COLOR" Foreground="White" FontFamily="{StaticResource TekoFont}"
                           FontSize="27" FontWeight="Bold" VerticalAlignment="Center"/>
                <Border x:Name="selectedPreview" Width="72" Height="34" CornerRadius="17"
                        BorderBrush="#70FFFFFF" BorderThickness="1.5" HorizontalAlignment="Right"/>
            </DockPanel>
            <Border Grid.Row="1" Background="#22FFFFFF"/>
            <Grid Grid.Row="2" Width="372" Height="372" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="368" Height="368" Fill="#16000000" Stroke="#35FFFFFF" StrokeThickness="1.5"/>
                <Image x:Name="colorWheel" Width="360" Height="360" Stretch="None"
                       MouseLeftButtonDown="ColorWheel_MouseLeftButtonDown"
                       MouseMove="ColorWheel_MouseMove" MouseLeftButtonUp="ColorWheel_MouseLeftButtonUp"
                       TouchDown="ColorWheel_TouchDown" TouchMove="ColorWheel_TouchMove"
                       TouchUp="ColorWheel_TouchUp"/>
                <Canvas Width="360" Height="360" IsHitTestVisible="False">
                    <Ellipse x:Name="selectionMarker" Width="24" Height="24"
                             Stroke="White" StrokeThickness="3" Fill="Transparent">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="0" Opacity="0.9"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button Content="CANCEL" Style="{StaticResource DialogButton}"
                        Background="#20FFFFFF" BorderBrush="#45FFFFFF"
                        Click="Cancel_Click"/>
                <Button Grid.Column="2" Content="APPLY" Style="{StaticResource DialogButton}"
                        Background="{DynamicResource ActionFillBrush}"
                        BorderBrush="{DynamicResource ActionAccentBrush}" Click="Apply_Click"/>
            </Grid>
        </Grid>
    </Border>
</local:SettingsWindow>
