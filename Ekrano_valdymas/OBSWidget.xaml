<UserControl x:Class="Ekrano_valdymas.OBSWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ekrano_valdymas"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="500" d:DesignHeight="370"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="Transparent">

    <Border local:CommonMetal.Surface="True" Background="{DynamicResource PanelMetalBrush}" BorderBrush="#35FFFFFF" BorderThickness="1.5"
            CornerRadius="18" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="72"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="45"><local:ModuleOptionsButton/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/ObsIcon.png"
                           Width="30" Height="30"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <local:OpticallyCenteredText x:Name="txtObsHeading" Tag="ModuleTitle"
                               Text="OBS CONTROLS" TextBrush="{DynamicResource ModuleTitleBrush}"
                               TextFontFamily="{StaticResource TekoFont}"
                               TextFontWeight="Bold" TextFontSize="27"
                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Margin="0,0,46,0" x:Name="txtRecordTime"
                           Text="00:00:00"
                           Foreground="#FF4A50"
                           FontSize="25"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource PanelDividerBrush}"/>

            <UniformGrid Grid.Row="2"
                         Columns="4"
                         Height="220"
                         Margin="-6,0,-6,0"
                         VerticalAlignment="Center">
                <Border x:Name="btnRecord" Margin="6,0" CornerRadius="14"
                        Background="{DynamicResource ModuleCardSurfaceBrush}" BorderBrush="#27FFFFFF"
                        BorderThickness="1.5" Cursor="Hand"
                        PreviewMouseDown="BtnRecord_PreviewMouseDown">
                    <Grid Margin="5,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="38"/>
                        </Grid.RowDefinitions>
                        <Grid Width="39" Height="39"
                              HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Ellipse Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2.4"/>
                            <Ellipse x:Name="recordIcon"
                                     Width="24" Height="24"
                                     Fill="{DynamicResource PrimaryTextBrush}"/>
                        </Grid>
                        <Viewbox Grid.Row="1"
                                 Width="110"
                                 Height="42"
                                 Stretch="Uniform"
                                 StretchDirection="DownOnly"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <TextBlock x:Name="txtRecordAction"
                                       Text="START REC"
                                       Width="110"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontFamily="{StaticResource TekoFont}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </Viewbox>
                        <Grid Grid.Row="2">
                            <Border Background="#24FFFFFF" CornerRadius="5"
                                    Padding="6,2" HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom">
                                <Viewbox MaxWidth="96" Height="24"
                                         Stretch="Uniform"
                                         StretchDirection="DownOnly">
                                    <TextBlock x:Name="txtRecordHotkey"
                                               Text="NO HOTKEY"
                                               Foreground="#F2FFFFFF"
                                               FontSize="20"
                                               FontWeight="SemiBold"/>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="btnReplayBuffer" Margin="6,0" CornerRadius="14"
                        Background="{DynamicResource ModuleCardSurfaceBrush}" BorderBrush="#27FFFFFF"
                        BorderThickness="1.5" Cursor="Hand"
                        PreviewMouseDown="BtnReplayBuffer_PreviewMouseDown">
                    <Grid Margin="5,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="38"/>
                        </Grid.RowDefinitions>
                        <Grid Width="40" Height="40"
                              HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Path x:Name="replayBufferIcon"
                                  Data="M20,4 A16,16 0 1 0 35,22 M34,9 L35,22 L23,19"
                                  Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2.6"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent" Stretch="Uniform"/>
                            <Path x:Name="replayBufferPlayIcon"
                                  Data="M16,12 L28,20 L16,28 Z"
                                  Fill="{DynamicResource PrimaryTextBrush}"
                                  Width="14" Height="18"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Grid>
                        <Border Grid.Row="2" Background="#24FFFFFF" CornerRadius="5"
                                Padding="6,2" HorizontalAlignment="Center"
                                VerticalAlignment="Bottom">
                            <Viewbox MaxWidth="96" Height="24"
                                     Stretch="Uniform"
                                     StretchDirection="DownOnly">
                                <TextBlock x:Name="txtReplayBufferHotkey"
                                           Text="NO HOTKEY"
                                           Foreground="#F2FFFFFF"
                                           FontSize="20"
                                           FontWeight="SemiBold"/>
                            </Viewbox>
                        </Border>
                        <Grid Grid.Row="1"
                              Width="110"
                              Height="72"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Viewbox Width="110"
                                     Height="72"
                                     Stretch="Uniform"
                                     StretchDirection="DownOnly">
                                <TextBlock x:Name="txtReplayAction"
                                           Text="REPLAY BUFFER"
                                           Width="104"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontFamily="{StaticResource TekoFont}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           LineStackingStrategy="BlockLineHeight"
                                           LineHeight="24"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Viewbox>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="btnSaveReplay" Margin="6,0" CornerRadius="14"
                        Background="{DynamicResource ModuleCardSurfaceBrush}" BorderBrush="#27FFFFFF"
                        BorderThickness="1.5" Cursor="Hand"
                        PreviewMouseDown="BtnSaveReplay_PreviewMouseDown">
                    <Grid Margin="5,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="38"/>
                        </Grid.RowDefinitions>
                        <Path x:Name="saveReplayIcon"
                              Data="M9,2 L15,2 L15,13 L20,13 L12,21 L4,13 L9,13 Z M2,22 L5,22 L5,26 L19,26 L19,22 L22,22 L22,29 L2,29 Z"
                              Fill="{DynamicResource PrimaryTextBrush}" Width="38" Height="38" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <Border Grid.Row="2" Background="#24FFFFFF" CornerRadius="5"
                                Padding="6,2" HorizontalAlignment="Center"
                                VerticalAlignment="Bottom">
                            <Viewbox MaxWidth="96" Height="24"
                                     Stretch="Uniform"
                                     StretchDirection="DownOnly">
                                <TextBlock x:Name="txtSaveReplayHotkey"
                                           Text="NO HOTKEY"
                                           Foreground="#F2FFFFFF"
                                           FontSize="20"
                                           FontWeight="SemiBold"/>
                            </Viewbox>
                        </Border>
                        <Grid Grid.Row="1"
                              Width="110"
                              Height="58"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                        <TextBlock x:Name="txtSaveReplayAction"
                                       Text="SAVE REPLAY"
                                       Width="104"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontFamily="{StaticResource TekoFont}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="btnReconnect" Margin="6,0" CornerRadius="14"
                        Background="{DynamicResource ModuleCardSurfaceBrush}" BorderBrush="#27FFFFFF"
                        BorderThickness="1.5" Cursor="Hand"
                        PreviewMouseDown="BtnReconnect_PreviewMouseDown">
                    <Grid Margin="5,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="38"/>
                        </Grid.RowDefinitions>
                        <Grid Width="40" Height="40"
                              HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Path Data="M8,9 A16,16 0 0 0 8,31 M14,14 A9,9 0 0 0 14,26 M32,9 A16,16 0 0 1 32,31 M26,14 A9,9 0 0 1 26,26"
                                  Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"
                                  Stretch="Uniform"/>
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource PrimaryTextBrush}"/>
                        </Grid>
                        <Viewbox Grid.Row="1"
                                 Width="110"
                                 Height="58"
                                 Stretch="Uniform"
                                 StretchDirection="DownOnly"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <TextBlock x:Name="txtConnectionAction"
                                       Text="START OBS"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontFamily="{StaticResource TekoFont}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       TextWrapping="NoWrap"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Viewbox>
                        <TextBlock Grid.Row="2" Text="OBS" Foreground="{DynamicResource PanelTextBrush}"
                                   FontSize="18" HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"/>
                    </Grid>
                </Border>
            </UniformGrid>

            <Border Grid.Row="3" Background="{DynamicResource PanelDividerBrush}"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="4,0,0,0">
                <StackPanel.RenderTransform>
                    <TranslateTransform Y="6"/>
                </StackPanel.RenderTransform>
                <TextBlock x:Name="txtStatusLabel" Text="Status:"
                           Foreground="{DynamicResource PanelTextBrush}" FontSize="23"/>
                <TextBlock x:Name="txtStatus" Text="Connecting..." Foreground="{DynamicResource PanelTextBrush}"
                           FontSize="23" FontWeight="SemiBold" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
