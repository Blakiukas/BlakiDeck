<UserControl x:Class="Ekrano_valdymas.WebShortcutsWidget"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Ekrano_valdymas">
 <Border local:CommonMetal.Surface="True" Background="{DynamicResource PanelMetalBrush}" BorderBrush="#35FFFFFF" BorderThickness="1.5" CornerRadius="18" Padding="22">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="1"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Tag="WindowDrag"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="browserToggle" Width="38" Height="36" Margin="0,0,6,0" Tag="NoWindowDrag" ToolTip="Open last used browser page" Style="{StaticResource ModuleOptionsButtonStyle}" Click="BrowserToggle_Click"><local:OpticallyCenteredText Width="20" Height="20" Text="&#xE774;" TextFontFamily="Segoe MDL2 Assets" TextFontSize="20" TextBrush="{DynamicResource PanelTextBrush}"/></Button><local:ModuleListButton x:Name="webModeButton" Margin="0,0,6,0" ToolTip="View: List · switch List / Thumbs / Icons" Click="ListButton_Click"/><Button x:Name="webSettingsButton" Width="38" Height="36" Padding="0" Tag="NoWindowDrag" ToolTip="Web shortcuts settings" Style="{StaticResource ModuleOptionsButtonStyle}" Click="Settings_Click"><local:OpticallyCenteredText Width="20" Height="20" Text="&#xE713;" TextFontFamily="Segoe MDL2 Assets" TextFontSize="20" TextBrush="{DynamicResource PanelTextBrush}"/></Button></StackPanel>
    <StackPanel Margin="0,0,136,0" Orientation="Horizontal" VerticalAlignment="Center">
     <Grid Width="36" Height="36"><local:OpticallyCenteredText Text="◎" TextBrush="{DynamicResource AccentBrush}" TextFontFamily="Segoe UI" TextFontSize="29" TextFontWeight="Normal"/></Grid>
     <local:OpticallyCenteredText Tag="ModuleTitle" Text="WEB SHORTCUTS" TextBrush="{DynamicResource ModuleTitleBrush}" TextFontFamily="{StaticResource TekoFont}" TextFontSize="27" Margin="12,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
   </Grid>
   <Border Grid.Row="1" Background="{DynamicResource PanelDividerBrush}"/>
   <ScrollViewer x:Name="webScroll" Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" ScrollChanged="PreviewScrollChanged"
                 HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
   <ItemsControl x:Name="tiles" VerticalAlignment="Top" AllowDrop="True" Drop="Tiles_Drop">
    <ItemsControl.Style>
     <Style TargetType="ItemsControl">
      <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></Setter.Value></Setter>
      <Style.Triggers>
       <DataTrigger Binding="{Binding ImagesOnly, RelativeSource={RelativeSource AncestorType={x:Type local:WebShortcutsWidget}}}" Value="True">
        <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></Setter.Value></Setter>
       </DataTrigger>
       <DataTrigger Binding="{Binding ViewMode, RelativeSource={RelativeSource AncestorType={x:Type local:WebShortcutsWidget}}}" Value="Icons">
        <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></Setter.Value></Setter>
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </ItemsControl.Style>
    <ItemsControl.ItemTemplate><DataTemplate>
     <Border x:Name="shortcutCard" Height="76" Margin="6,4" CornerRadius="13" Background="{DynamicResource ModuleCardSurfaceBrush}"
             ToolTip="{Binding DisplayName}" AutomationProperties.Name="{Binding DisplayName}"
             BorderBrush="#48FFFFFF" BorderThickness="1.3" Cursor="Hand" ClipToBounds="True"
             AllowDrop="True" Tag="NoWindowDrag"
             PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown"
             PreviewMouseMove="Tile_PreviewMouseMove" PreviewMouseLeftButtonUp="Tile_PreviewMouseLeftButtonUp"
             PreviewTouchDown="Tile_PreviewTouchDown" PreviewTouchMove="Tile_PreviewTouchMove"
             PreviewTouchUp="Tile_PreviewTouchUp" DragEnter="Tile_DragEnter" ContextMenuOpening="Tile_ContextMenuOpening"
             DragLeave="Tile_DragLeave" DragOver="Tile_DragOver" Drop="Tile_Drop">
       <Border.ContextMenu><ContextMenu/></Border.ContextMenu>
      <Grid><local:MicrophoneMacroFrame Target="{Binding Url}"><Grid x:Name="tileContent" Margin="10,7">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="previewColumn" Width="176"/></Grid.ColumnDefinitions>
       <local:OpticallyCenteredText x:Name="shortcutTextOnly" Grid.ColumnSpan="2" Visibility="Collapsed" Text="{Binding DisplayName}" TextBrush="{DynamicResource PanelTextBrush}" TextFontFamily="{Binding MacroTypography.Face, FallbackValue=Segoe UI}" TextFontSize="{Binding MacroTypography.SafeSize, FallbackValue=20}" TextFontWeight="{Binding MacroTypography.Weight, FallbackValue=SemiBold}" TextFontStyle="{Binding MacroTypography.Style, FallbackValue=Normal}" local:LabelTypography.TextEffect="{Binding MacroTypography}" Ellipsis="True" ClipToBounds="True"/>
       <Grid x:Name="shortcutBoth" Grid.ColumnSpan="2" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <local:AdaptiveIconImage ShortcutTarget="{Binding PreviewEffectTarget}" SkinIcon="False" Source="{Binding PreviewImage}" Stretch="Uniform"/>
        <local:OpticallyCenteredText Text="{Binding Symbol}" TextBrush="{DynamicResource PanelTextBrush}" TextFontFamily="Segoe UI Symbol" TextFontSize="25"><local:OpticallyCenteredText.Style><Style TargetType="local:OpticallyCenteredText"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:OpticallyCenteredText.Style></local:OpticallyCenteredText>
        <local:OpticallyCenteredText x:Name="shortcutBothText" Grid.Row="1" CompactLineBox="True" Text="{Binding DisplayName}" TextBrush="{DynamicResource PanelTextBrush}" TextFontFamily="{Binding MacroTypography.Face, FallbackValue=Segoe UI}" TextFontSize="{Binding MacroTypography.SafeSize, FallbackValue=18}" TextFontWeight="{Binding MacroTypography.Weight, FallbackValue=Normal}" TextFontStyle="{Binding MacroTypography.Style, FallbackValue=Normal}" local:LabelTypography.TextEffect="{Binding MacroTypography}" Ellipsis="True" ClipToBounds="True"/>
       </Grid>
       <local:OpticallyCenteredText x:Name="shortcutName" Grid.Column="0" Margin="4,0,14,0" Text="{Binding DisplayName}" TextBrush="{DynamicResource PanelTextBrush}"
                  TextFontFamily="{Binding MacroTypography.Face, FallbackValue=Segoe UI}" TextFontSize="{Binding MacroTypography.SafeSize, FallbackValue=20}" TextFontWeight="{Binding MacroTypography.Weight, FallbackValue=Bold}" TextFontStyle="{Binding MacroTypography.Style, FallbackValue=Normal}" local:LabelTypography.TextEffect="{Binding MacroTypography}" VerticalAlignment="Center"
                  Ellipsis="True" ClipToBounds="True" InkAlignment="Left"/>
       <Border x:Name="shortcutPreview" Grid.Column="1" CornerRadius="8" ClipToBounds="True" Background="#30101010">
        <Grid>
         <local:AdaptiveIconImage SkinIcon="False" x:Name="shortcutPreviewImage" Source="{Binding PreviewImage}" Stretch="UniformToFill" StretchDirection="Both"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0.9">
          <local:AdaptiveIconImage.Style><Style TargetType="local:AdaptiveIconImage"><Setter Property="ShortcutTarget" Value="{Binding PreviewEffectTarget}"/></Style></local:AdaptiveIconImage.Style>
         </local:AdaptiveIconImage>
         <TextBlock Text="{Binding Symbol}" Foreground="{DynamicResource AccentBrush}" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=shortcutPreviewImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
         </TextBlock>
        </Grid>
       </Border>
       <Grid x:Name="listRow" Grid.ColumnSpan="2" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Width="18" Height="18" VerticalAlignment="Center">
         <local:OpticallyCenteredText Text="{Binding Symbol}" TextFontFamily="Segoe UI Symbol" TextFontSize="16" TextBrush="White"><local:OpticallyCenteredText.Style><Style TargetType="local:OpticallyCenteredText"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Favicon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:OpticallyCenteredText.Style></local:OpticallyCenteredText>
         <local:AdaptiveIconImage ShortcutTarget="{Binding Url}" Source="{Binding Favicon}" Stretch="Uniform"/>
        </Grid>
        <local:OpticallyCenteredText x:Name="listLabel" Grid.Column="1" Text="{Binding DisplayName}" TextFontFamily="Segoe UI" TextFontWeight="Normal" TextFontSize="{Binding ListTextSize, RelativeSource={RelativeSource AncestorType={x:Type local:WebShortcutsWidget}}}" TextBrush="{Binding ListTextBrush, RelativeSource={RelativeSource AncestorType={x:Type local:WebShortcutsWidget}}}" InkAlignment="Left" Ellipsis="True" ClipToBounds="True"/>
       </Grid>
       <Grid x:Name="iconOnlyCell" Grid.ColumnSpan="2" Visibility="Collapsed" Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type local:WebShortcutsWidget}}}" Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type local:WebShortcutsWidget}}}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <local:AdaptiveIconImage ShortcutTarget="{Binding Url}" x:Name="iconOnlyImage" SkinIcon="False" Source="{Binding IconOnlyImage}" Stretch="Uniform"/>
        <local:OpticallyCenteredText Text="{Binding Symbol}" TextFontFamily="Segoe UI Symbol" TextFontSize="{Binding IconFallbackSize, RelativeSource={RelativeSource AncestorType={x:Type local:WebShortcutsWidget}}}" TextBrush="{DynamicResource PanelTextBrush}">
         <local:OpticallyCenteredText.Style><Style TargetType="local:OpticallyCenteredText"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IconOnlyImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:OpticallyCenteredText.Style>
        </local:OpticallyCenteredText>
       </Grid>
      </Grid>
     </local:MicrophoneMacroFrame>
      <Button x:Name="capturePreviewButton" Width="26" Height="26" Margin="0,8,8,0" HorizontalAlignment="Right" VerticalAlignment="Top" Tag="NoWindowDrag" Padding="0" Click="CapturePreview_Click" IsEnabled="{Binding CanCapturePreview}" ToolTip="{Binding CaptureHint}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding CaptureHint}">
       <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ModuleOptionsButtonStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ViewMode, RelativeSource={RelativeSource AncestorType={x:Type local:WebShortcutsWidget}}}" Value="Thumbs"/><Condition Binding="{Binding IsAdd}" Value="False"/><Condition Binding="{Binding IsMacro}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Button.Style>
       <local:OpticallyCenteredText Text="{Binding CaptureGlyph}" TextFontFamily="Segoe MDL2 Assets" TextFontSize="16" TextBrush="{DynamicResource PanelTextBrush}"/>
      </Button></Grid></Border>
     <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsAdd}" Value="True">
       <Setter TargetName="listLabel" Property="TextFontSize" Value="{Binding AddWebLinkListTextSize, RelativeSource={RelativeSource AncestorType={x:Type local:WebShortcutsWidget}}}"/>
       <Setter TargetName="shortcutName" Property="TextFontSize" Value="13.3333333333333"/>
       <Setter TargetName="shortcutTextOnly" Property="TextFontSize" Value="13.3333333333333"/>
       <Setter TargetName="shortcutBothText" Property="TextFontSize" Value="12"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding ImagesOnly, RelativeSource={RelativeSource AncestorType={x:Type local:WebShortcutsWidget}}}" Value="True">
       <!-- One pair occupies the same height as two original 76+8 rows. -->
       <Setter TargetName="shortcutCard" Property="Height" Value="160"/>
       <Setter TargetName="shortcutName" Property="Visibility" Value="Collapsed"/>
       <Setter TargetName="shortcutPreview" Property="Grid.Column" Value="0"/>
       <Setter TargetName="shortcutPreview" Property="Grid.ColumnSpan" Value="2"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding DisplayedPresentation}" Value="Text">
       <Setter TargetName="shortcutName" Property="Visibility" Value="Collapsed"/>
       <Setter TargetName="shortcutTextOnly" Property="Visibility" Value="Visible"/>
       <Setter TargetName="shortcutPreview" Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding DisplayedPresentation}" Value="Icon">
       <Setter TargetName="shortcutPreviewImage" Property="Stretch" Value="Uniform"/>
       <Setter TargetName="shortcutName" Property="Visibility" Value="Collapsed"/>
       <Setter TargetName="shortcutPreview" Property="Grid.Column" Value="0"/>
       <Setter TargetName="shortcutPreview" Property="Grid.ColumnSpan" Value="2"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding DisplayedPresentation}" Value="IconText">
       <Setter TargetName="shortcutName" Property="Visibility" Value="Collapsed"/>
       <Setter TargetName="shortcutPreview" Property="Visibility" Value="Collapsed"/>
       <Setter TargetName="shortcutBoth" Property="Visibility" Value="Visible"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding ImagesOnly, RelativeSource={RelativeSource AncestorType={x:Type local:WebShortcutsWidget}}}" Value="False">
       <Setter TargetName="shortcutCard" Property="Height" Value="{Binding ListRowHeight, RelativeSource={RelativeSource AncestorType={x:Type local:WebShortcutsWidget}}}"/>
       <Setter TargetName="shortcutCard" Property="Margin" Value="0"/>
       <Setter TargetName="shortcutCard" Property="CornerRadius" Value="0"/>
       <Setter TargetName="shortcutCard" Property="BorderThickness" Value="0"/>
       <Setter TargetName="shortcutCard" Property="Background" Value="Transparent"/>
       <Setter TargetName="tileContent" Property="Margin" Value="8,0"/>
       <Setter TargetName="shortcutName" Property="Visibility" Value="Collapsed"/>
       <Setter TargetName="shortcutPreview" Property="Visibility" Value="Collapsed"/>
       <Setter TargetName="shortcutTextOnly" Property="Visibility" Value="Collapsed"/>
       <Setter TargetName="shortcutBoth" Property="Visibility" Value="Collapsed"/>
       <Setter TargetName="listRow" Property="Visibility" Value="Visible"/>
      </DataTrigger>
      <Trigger SourceName="listRow" Property="IsMouseOver" Value="True"><Setter TargetName="listRow" Property="Background" Value="Transparent"/></Trigger>
      <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ViewMode, RelativeSource={RelativeSource AncestorType={x:Type local:WebShortcutsWidget}}}" Value="Thumbs"/><Condition Binding="{Binding IsMacro}" Value="False"/><Condition Binding="{Binding IsAdd}" Value="False"/></MultiDataTrigger.Conditions>
       <Setter TargetName="shortcutName" Property="Visibility" Value="Collapsed"/><Setter TargetName="shortcutTextOnly" Property="Visibility" Value="Collapsed"/><Setter TargetName="shortcutBoth" Property="Visibility" Value="Collapsed"/><Setter TargetName="listRow" Property="Visibility" Value="Collapsed"/>
       <Setter TargetName="shortcutPreview" Property="Visibility" Value="Visible"/><Setter TargetName="shortcutPreview" Property="Grid.Column" Value="0"/><Setter TargetName="shortcutPreview" Property="Grid.ColumnSpan" Value="2"/>
       <Setter TargetName="shortcutPreviewImage" Property="Source" Value="{Binding ThumbnailImage}"/><Setter TargetName="shortcutPreviewImage" Property="Stretch" Value="{Binding ThumbnailStretch}"/>
       <Setter TargetName="shortcutPreviewImage" Property="ShortcutTarget" Value="{Binding ThumbnailEffectTarget}"/>
      </MultiDataTrigger>
      <DataTrigger Binding="{Binding ViewMode, RelativeSource={RelativeSource AncestorType={x:Type local:WebShortcutsWidget}}}" Value="Icons">
       <Setter TargetName="previewColumn" Property="ColumnDefinition.Width" Value="0"/>
       <Setter TargetName="shortcutCard" Property="Width" Value="{Binding IconTileExtent, RelativeSource={RelativeSource AncestorType={x:Type local:WebShortcutsWidget}}}"/>
       <Setter TargetName="shortcutCard" Property="Height" Value="{Binding IconTileExtent, RelativeSource={RelativeSource AncestorType={x:Type local:WebShortcutsWidget}}}"/>
       <Setter TargetName="shortcutCard" Property="Margin" Value="6,4"/><Setter TargetName="shortcutCard" Property="CornerRadius" Value="13"/><Setter TargetName="shortcutCard" Property="BorderThickness" Value="1.3"/><Setter TargetName="shortcutCard" Property="Background" Value="{DynamicResource ModuleCardSurfaceBrush}"/>
       <Setter TargetName="tileContent" Property="Margin" Value="8"/>
       <Setter TargetName="shortcutName" Property="Visibility" Value="Collapsed"/><Setter TargetName="shortcutPreview" Property="Visibility" Value="Collapsed"/><Setter TargetName="shortcutTextOnly" Property="Visibility" Value="Collapsed"/><Setter TargetName="shortcutBoth" Property="Visibility" Value="Collapsed"/><Setter TargetName="listRow" Property="Visibility" Value="Collapsed"/>
       <Setter TargetName="iconOnlyCell" Property="Visibility" Value="Visible"/>
      </DataTrigger>
     </DataTemplate.Triggers>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   </ScrollViewer>
  </Grid>
 </Border>
</UserControl>

