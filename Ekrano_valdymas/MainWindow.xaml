    <Grid ClipToBounds="True" Background="#01000000">
        <ContentControl x:Name="dashboardHost">
        <Viewbox x:Name="dashboardViewbox"
             PreviewMouseRightButtonDown="DashboardViewbox_PreviewMouseRightButtonDown"
             PreviewMouseRightButtonUp="DashboardViewbox_PreviewMouseRightButtonUp"
             Stretch="Uniform"
             StretchDirection="Both"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
        <Grid x:Name="dashboardCanvas"
              Width="1920"
              Height="560">
            <Border x:Name="dashboardBackdrop" Margin="10" CornerRadius="20"
                    Background="{DynamicResource DashboardBackdropBrush}"/>
            <Border x:Name="dashboardContentFrame" Margin="10"
                    Background="#01000000"
                    CornerRadius="20">

                <Grid LayoutUpdated="DashboardGrid_LayoutUpdated">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="musicTopBarRow" Height="104"/>
                        <RowDefinition x:Name="moduleGapRow" Height="9"/>
                        <RowDefinition x:Name="widgetsRow" Height="*"/>
                    </Grid.RowDefinitions>

                    <local:QuickLaunchBar x:Name="quickLaunchBar" Grid.Row="0"
                                          CompactModeRequested="QuickLaunchBar_CompactModeRequested"/>

                    <Grid x:Name="widgetsGrid" Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ContentControl x:Name="leftModuleHost" Grid.Column="0">
                            <local:SpotifyWidget x:Name="spotifyWidget"/>
                        </ContentControl>

                        <ContentControl x:Name="centerModuleHost" Grid.Column="2">
                            <local:OBSWidget x:Name="obsWidget"/>
                        </ContentControl>

                        <ContentControl x:Name="rightModuleHost" Grid.Column="4">
                            <local:WeatherWidget x:Name="weatherWidget"/>
                        </ContentControl>
                        <ContentControl x:Name="musicConsoleHost" Grid.Column="0" Grid.ColumnSpan="5"
                                        Panel.ZIndex="20" Visibility="Collapsed"/>
                        <ContentControl x:Name="wideShortcutsHost" Grid.Column="0" Grid.ColumnSpan="3"
                                        Visibility="Collapsed"/>
                    </Grid>

                </Grid>
            </Border>
            <Border x:Name="autoDimOverlay"
                    Panel.ZIndex="10000"
                    Background="Black"
                    Opacity="0"
                    IsHitTestVisible="False"/>
        </Grid>
    </Viewbox>
        </ContentControl>
    </Grid>
</Window>







