<local:SettingsWindow xmlns:local="clr-namespace:Ekrano_valdymas" x:Class="Ekrano_valdymas.AccentColorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Colors and lights" Width="540" Height="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FF1A1714">
    <Border Background="#FF1A1714" BorderThickness="0" CornerRadius="16" Padding="16"
>
        <Grid>
            <Grid.Resources>
                <Style x:Key="TargetRadio" TargetType="RadioButton">
                    <Setter Property="Foreground" Value="#DDFFFFFF"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Height" Value="28"/><Setter Property="Margin" Value="0,3,8,3"/>
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                            <Border x:Name="face" CornerRadius="4" BorderBrush="#50FFFFFF" BorderThickness="1" Background="Transparent" Margin="0,0,4,0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <Border x:Name="targetColor" Grid.Column="1" Width="28" Height="28" Background="{TemplateBinding Background}" BorderBrush="#50FFFFFF" BorderThickness="1" CornerRadius="3"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="face" Property="Background" Value="#32FFFFFF"/><Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource ActionAccentBrush}"/><Setter Property="Foreground" Value="White"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="face" Property="Background" Value="#32FFFFFF"/><Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource ActionAccentBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value></Setter>
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Visibility="Collapsed"><Border x:Name="preview"/><TextBlock x:Name="dialogHeading"/></StackPanel>

            <StackPanel Grid.Row="1" Margin="0,10,0,4"><UniformGrid Columns="3" Rows="3">
                <RadioButton x:Name="systemTargetRadio" Content="DASH" GroupName="ColorTarget"
                             IsChecked="True" Style="{StaticResource TargetRadio}"/>
                <RadioButton x:Name="clockTargetRadio" Content="CLOCK" GroupName="ColorTarget"
                             Style="{StaticResource TargetRadio}"/>
                <RadioButton x:Name="systemMonitorTargetRadio" Content="SENSOR VALUES" GroupName="ColorTarget"
                             FontSize="13" Style="{StaticResource TargetRadio}"/>
                <RadioButton x:Name="baseTargetRadio" Content="BASE" GroupName="ColorTarget"
                             Style="{StaticResource TargetRadio}"/>
                <RadioButton x:Name="textTargetRadio" Content="OTHER TEXT" FontSize="13" GroupName="ColorTarget"
                             Style="{StaticResource TargetRadio}"/>
                
                <RadioButton x:Name="titlesTargetRadio" Content="MODULE TITLES" GroupName="ColorTarget" FontSize="13" Style="{StaticResource TargetRadio}"/>
                <RadioButton x:Name="labelsTargetRadio" Content="PANEL LABELS" GroupName="ColorTarget" FontSize="13" Style="{StaticResource TargetRadio}"/>
            </UniformGrid>
                <TextBlock Text="PLAYER" Foreground="#DDFFFFFF" FontSize="13" Margin="0,6,0,0"/>
                <UniformGrid Columns="3" Rows="1">
                    <RadioButton x:Name="musicTargetRadio" Content="BUTTONS" GroupName="ColorTarget" Style="{StaticResource TargetRadio}"/>
                    <RadioButton x:Name="knobTargetRadio" Content="KNOB" GroupName="ColorTarget" Style="{StaticResource TargetRadio}"/>
                    <RadioButton x:Name="powerTargetRadio" Content="POWER" GroupName="ColorTarget" Style="{StaticResource TargetRadio}"/>
                </UniformGrid></StackPanel>

            <Grid Grid.Row="2" Margin="0,12,0,16" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="154"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="targetDescription" Grid.ColumnSpan="4" TextWrapping="Wrap" Foreground="#DDFFFFFF" FontSize="13" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="1" Text="HEX" Foreground="#DFFFFFFF" FontSize="15"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" x:Name="hexText" Grid.Column="1" Height="38" Padding="10,4"
                         FontSize="20" MaxLength="7"
                         LostKeyboardFocus="HexText_LostKeyboardFocus"
                         KeyDown="HexText_KeyDown"/>
                <Button Grid.Row="1" x:Name="sampleColorButton" Grid.Column="3" Width="38" Height="38"
                        HorizontalAlignment="Right" ToolTip="Pick a color from the screen"
                        Style="{StaticResource DashboardDialogButton}"
                        Click="SampleColorButton_Click">
                    <Viewbox Width="22" Height="22">
                        <Canvas Width="24" Height="24">
                            <Path Fill="Transparent" Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M19.35,11.72 L13.03,5.4 L14.79,3.64 C15.57,2.86 16.83,2.86 17.61,3.64 L21.11,7.14 C21.89,7.92 21.89,9.18 21.11,9.96 Z M12.32,6.11 L4.6,13.83 C4.22,14.21 4,14.72 4,15.25 L4,18 L2,20 L4,22 L6,20 L8.75,20 C9.28,20 9.79,19.78 10.17,19.4 L17.89,11.68"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>

            <ContentControl x:Name="pickerHost" Grid.Row="3" Margin="0,10,0,8"/>
            <UniformGrid Visibility="Collapsed" x:Name="paletteGrid" Grid.Row="3" Columns="8" Rows="3" Margin="0,0,0,18">
                <UniformGrid.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="4"/>
                        <Setter Property="BorderBrush" Value="#55FFFFFF"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="swatch"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="7">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="swatch" Property="BorderBrush" Value="White"/>
                                            <Setter TargetName="swatch" Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="SavedColorSwatch" TargetType="Button"
                           BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Margin" Value="1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="savedOuter"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="3" CornerRadius="10"
                                            Background="#242C2C2C" Padding="3">
                                        <Border x:Name="savedInner"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="#CFFFFFFF"
                                                BorderThickness="1" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="savedInner" Property="BorderBrush" Value="White"/>
                                            <Setter TargetName="savedInner" Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="savedOuter" Property="Opacity" Value="0.72"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </UniformGrid.Resources>
                <Button Tag="#1ED760" Background="#1ED760" Click="PaletteColor_Click"/>
                <Button Tag="#2E7D32" Background="#2E7D32" Click="PaletteColor_Click"/>
                <Button Tag="#00BFA5" Background="#00BFA5" Click="PaletteColor_Click"/>
                <Button Tag="#00BCD4" Background="#00BCD4" Click="PaletteColor_Click"/>
                <Button Tag="#2196F3" Background="#2196F3" Click="PaletteColor_Click"/>
                <Button Tag="#3F51B5" Background="#3F51B5" Click="PaletteColor_Click"/>
                <Button Tag="#673AB7" Background="#673AB7" Click="PaletteColor_Click"/>
                <Button Tag="#9C27B0" Background="#9C27B0" Click="PaletteColor_Click"/>
                <Button Tag="#E91E63" Background="#E91E63" Click="PaletteColor_Click"/>
                <Button Tag="#C62828" Background="#C62828" Click="PaletteColor_Click"/>
                <Button Tag="#FF5722" Background="#FF5722" Click="PaletteColor_Click"/>
                <Button Tag="#FF9800" Background="#FF9800" Click="PaletteColor_Click"/>
                <Button Tag="#FFC107" Background="#FFC107" Click="PaletteColor_Click"/>
                <Button Tag="#FFEB3B" Background="#FFEB3B" Click="PaletteColor_Click"/>
                <Button Tag="#CDDC39" Background="#CDDC39" Click="PaletteColor_Click"/>
                <Button Tag="#8BC34A" Background="#8BC34A" Click="PaletteColor_Click"/>
                <Button Tag="#FFFFFF" Background="#FFFFFF" Click="PaletteColor_Click"/>
                <Button Tag="#BDBDBD" Background="#BDBDBD" Click="PaletteColor_Click"/>
                <Button Tag="#757575" Background="#757575" Click="PaletteColor_Click"/>
                <Button Tag="#424242" Background="#424242" Click="PaletteColor_Click"/>
                <Button x:Name="savedColor1" Tag="#263238" Background="#263238"
                        Style="{StaticResource SavedColorSwatch}" Click="PaletteColor_Click"/>
                <Button x:Name="savedColor2" Tag="#795548" Background="#795548"
                        Style="{StaticResource SavedColorSwatch}" Click="PaletteColor_Click"/>
                <Button x:Name="savedColor3" Tag="#607D8B" Background="#607D8B"
                        Style="{StaticResource SavedColorSwatch}" Click="PaletteColor_Click"/>
                <Button x:Name="savedColor4" Tag="#000000" Background="#000000"
                        Style="{StaticResource SavedColorSwatch}" Click="PaletteColor_Click"/>
            </UniformGrid>

            <Grid Visibility="Collapsed" x:Name="tonePanel" Grid.Row="4" Margin="4,0,4,12" Height="54">
                <Grid Height="54">
                    <Border Height="22" CornerRadius="11" VerticalAlignment="Center"
                            BorderBrush="#50FFFFFF" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="White" Offset="0.08"/>
                                <GradientStop Color="#FFFF3030" Offset="0.12"/>
                                <GradientStop Color="#FFFF3030" Offset="0.18"/>
                                <GradientStop Color="#FFFF9800" Offset="0.22"/>
                                <GradientStop Color="#FFFF9800" Offset="0.28"/>
                                <GradientStop Color="#FFFFFF32" Offset="0.32"/>
                                <GradientStop Color="#FFFFFF32" Offset="0.38"/>
                                <GradientStop Color="#FF32D75F" Offset="0.42"/>
                                <GradientStop Color="#FF32D75F" Offset="0.48"/>
                                <GradientStop Color="#FF20D7E5" Offset="0.52"/>
                                <GradientStop Color="#FF20D7E5" Offset="0.58"/>
                                <GradientStop Color="#FF318CE7" Offset="0.62"/>
                                <GradientStop Color="#FF318CE7" Offset="0.68"/>
                                <GradientStop Color="#FF7650D8" Offset="0.72"/>
                                <GradientStop Color="#FF7650D8" Offset="0.78"/>
                                <GradientStop Color="#FFD52AA7" Offset="0.82"/>
                                <GradientStop Color="#FFD52AA7" Offset="0.88"/>
                                <GradientStop Color="Black" Offset="0.92"/>
                                <GradientStop Color="Black" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Slider x:Name="toneSlider" Minimum="0" Maximum="100" Value="50" Height="54"
                            Background="Transparent" ValueChanged="ToneSlider_ValueChanged">
                        <Slider.Template>
                            <ControlTemplate TargetType="Slider">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Opacity="0"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Width="20" Height="38">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Ellipse Width="12" Height="12" Fill="#EF7900"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Opacity="0"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Slider.Template>
                    </Slider>
                </Grid>
            </Grid>

            <Grid Visibility="Collapsed" x:Name="intensityPanel" Grid.Row="5" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="intensityLabel" Text="TRANSPARENCY" Foreground="#DFFFFFFF"
                           FontSize="15" VerticalAlignment="Center"/>
                <Slider x:Name="intensitySlider" Grid.Column="1" Minimum="0" Maximum="100"
                        Height="42" VerticalAlignment="Center" Style="{StaticResource DashboardSlider}"
                        TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="IntensitySlider_ValueChanged"/>
                <TextBlock x:Name="intensityText" Grid.Column="2" Foreground="White" FontSize="15"
                           TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

        </Grid>
    </Border>
</local:SettingsWindow>

