<UserControl x:Class="Ekrano_valdymas.SpotifyWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ekrano_valdymas"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="500" d:DesignHeight="370"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="GreenSlider" TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="46" Background="Transparent">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" CornerRadius="2.5" Background="{DynamicResource AccentBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" CornerRadius="2.5" Background="#22FFFFFF"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="31" Height="31" Cursor="Hand" Background="Transparent">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Ellipse Width="24" Height="24" Fill="{DynamicResource SpotifyControlBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border local:CommonMetal.Surface="True" Background="{DynamicResource PanelMetalBrush}"
            BorderBrush="#35FFFFFF"
            BorderThickness="1.5"
            CornerRadius="18"
            Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="72"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="41*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="59*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0"
                        Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentBrush}">
                    <Path Data="M7,18 V8 L17,5 V15 M7,18 A3,3 0 1 1 4,15 A3,3 0 0 1 7,18 M17,15 A3,3 0 1 1 14,12 A3,3 0 0 1 17,15"
                          Fill="#101416" Width="18" Height="18" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <local:OpticallyCenteredText x:Name="txtServiceHeading" Tag="ModuleTitle"
                           Text="SPOTIFY" TextBrush="{DynamicResource ModuleTitleBrush}"
                           TextFontFamily="{StaticResource TekoFont}" TextFontWeight="Bold"
                           TextFontSize="27" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <local:ModuleOptionsButton Grid.Column="2"/>
            <StackPanel Margin="0,0,46,0" Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="VOL" Foreground="{DynamicResource PanelTextBrush}" FontFamily="{StaticResource TekoFont}"
                           FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider x:Name="applicationVolumeSlider" Width="135" Height="46"
                        Style="{StaticResource GreenSlider}" Minimum="0" Maximum="100"
                        Value="100" VerticalAlignment="Center" Cursor="Hand"
                        ValueChanged="ApplicationVolumeSlider_ValueChanged"/>
                <TextBlock x:Name="applicationVolumeText" Text="100%" Width="48"
                           Foreground="{DynamicResource PanelTextBrush}" FontSize="15" TextAlignment="Right"
                           VerticalAlignment="Center" Margin="7,0,0,0"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Background="{DynamicResource PanelDividerBrush}"/>

            <Border Grid.Row="2" Grid.Column="0"
                    Width="220"
                    Height="220"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="7"
                    Background="Transparent"
                    ClipToBounds="True">
                    <Grid>
                        <Image x:Name="txtNoCover"
                               Source="/Assets/SpotifyStandbyTransparent.png"
                               Stretch="Uniform"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               Opacity="0.88"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Image x:Name="imgCover" Stretch="UniformToFill"/>
                    </Grid>
            </Border>

            <Grid x:Name="playerDetails"
                  Grid.Row="2" Grid.Column="2"
                  Height="220"
                  VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Border Width="56" Height="56" Background="Transparent"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Cursor="Hand" PreviewMouseDown="BtnHeart_PreviewMouseDown">
                        <TextBlock x:Name="btnHeart" Text="♡" Foreground="{DynamicResource AccentBrush}"
                                   FontSize="39" FontFamily="Segoe UI Symbol"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <Border x:Name="timelineTouchArea" Height="44" Margin="0,-16,0,-15"
                                Background="Transparent" Tag="NoWindowDrag" Cursor="Hand"
                                PreviewMouseLeftButtonDown="Timeline_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="Timeline_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="Timeline_PreviewMouseLeftButtonUp"
                                PreviewTouchDown="Timeline_PreviewTouchDown"
                                PreviewTouchMove="Timeline_PreviewTouchMove"
                                PreviewTouchUp="Timeline_PreviewTouchUp">
                            <ProgressBar x:Name="progressSong" Value="0" Maximum="100" Height="8"
                                         IsHitTestVisible="False" VerticalAlignment="Center"
                                         Background="#1EFFFFFF" Foreground="{DynamicResource AccentBrush}" BorderThickness="0"/>
                        </Border>
                        <Grid Margin="0,8,0,0">
                            <TextBlock x:Name="txtTimeCurrent" Text="0:00"
                                       Foreground="{DynamicResource PanelTextBrush}" FontSize="15"/>
                            <TextBlock x:Name="txtTimeTotal" Text="0:00"
                                       Foreground="{DynamicResource PanelTextBrush}" FontSize="15"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="2"
                            Margin="0,7,0,0"
                            Height="98"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource ModuleCardSurfaceBrush}"
                            BorderBrush="#4CFFFFFF"
                            BorderThickness="1.4"
                            CornerRadius="14">
                        <Grid ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="btnPrev"
                                    Grid.Column="0"
                                    PreviewMouseDown="BtnPrev_PreviewMouseDown"
                                    Background="Transparent"
                                    Cursor="Hand">
                                <Grid Width="36"
                                      Height="30"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <Border Width="5"
                                            Height="28"
                                            Background="{DynamicResource SpotifyControlBrush}"
                                            CornerRadius="2.5"
                                            HorizontalAlignment="Left"/>
                                    <Path Data="M 25,3 Q 26,2 26,5 L 26,25 Q 26,28 24,27 L 3,17 Q 0,15 3,13 L 24,3 Z"
                                          Fill="{DynamicResource SpotifyControlBrush}"
                                          Width="27"
                                          Height="30"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1"
                                    BorderBrush="#40FFFFFF"
                                    BorderThickness="1,0,1,0">
                                <Border x:Name="btnPlayPause"
                                        PreviewMouseDown="BtnPlayPause_PreviewMouseDown"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="5"
                                        CornerRadius="41"
                                        Width="82"
                                        Height="82"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Cursor="Hand">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#1ED760" BlurRadius="12" Opacity="0.34" ShadowDepth="0"/>
                                    </Border.Effect>
                                    <Grid Width="34"
                                          Height="34"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Canvas Width="34" Height="34">
                                            <Path x:Name="iconPlay"
                                                  Data="M 33,17 L 9,30.8564 L 9,3.1436 Z"
                                                  Fill="{DynamicResource SpotifyControlBrush}"
                                                  Stretch="None"/>
                                        </Canvas>
                                        <StackPanel x:Name="iconPause"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Visibility="Collapsed">
                                            <Border Width="7"
                                                    Height="25"
                                                    Background="{DynamicResource SpotifyControlBrush}"
                                                    CornerRadius="3.5"/>
                                            <Border Width="7"
                                                    Height="25"
                                                    Margin="6,0,0,0"
                                                    Background="{DynamicResource SpotifyControlBrush}"
                                                    CornerRadius="3.5"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Border>

                            <Border x:Name="btnNext"
                                    Grid.Column="2"
                                    PreviewMouseDown="BtnNext_PreviewMouseDown"
                                    Background="Transparent"
                                    Cursor="Hand">
                                <Grid Width="36"
                                      Height="30"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <Path Data="M 2,3 Q 1,2 1,5 L 1,25 Q 1,28 3,27 L 24,17 Q 27,15 24,13 L 3,3 Z"
                                          Fill="{DynamicResource SpotifyControlBrush}"
                                          Width="27"
                                          Height="30"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Left"/>
                                    <Border Width="5"
                                            Height="28"
                                            Background="{DynamicResource SpotifyControlBrush}"
                                            CornerRadius="2.5"
                                            HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
            </Grid>

            <Border Grid.Row="3" Grid.ColumnSpan="3" Background="{DynamicResource PanelDividerBrush}"/>

            <Grid Grid.Row="4" Grid.ColumnSpan="3" Margin="12,5,12,2">
                <Grid.RenderTransform>
                    <TranslateTransform Y="6"/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="txtTitle" Text="Song"
                           Foreground="{DynamicResource PanelTextBrush}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Bottom"/>
                <TextBlock x:Name="txtArtist" Grid.Row="1" Text="Artist"
                           Foreground="{DynamicResource PanelTextBrush}"
                           FontSize="19"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Top"
                           Margin="0,1,0,0"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
