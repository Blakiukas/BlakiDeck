<UserControl x:Class="Ekrano_valdymas.ShortcutsWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ekrano_valdymas">
    <Border local:CommonMetal.Surface="True" Background="{DynamicResource PanelMetalBrush}"
            BorderBrush="#40FFFFFF" BorderThickness="1.5" CornerRadius="18" Padding="22">
        <Grid>
            <Grid.RowDefinitions><RowDefinition x:Name="moduleTitleRow" Height="45"/><RowDefinition x:Name="moduleTitleDividerRow" Height="1"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><local:ModuleListButton Click="ListButton_Click" Margin="0,0,4,0"/><local:ModuleOptionsButton/></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,88,0" VerticalAlignment="Center">
            <local:ModuleHeaderIcon Kind="Link" Width="30" Height="30" Margin="0,0,12,0" Tag="ModuleIcon"/>
            <local:OpticallyCenteredText Tag="ModuleTitle" Text="SHORTCUTS" TextBrush="{DynamicResource ModuleTitleBrush}"
                       TextFontFamily="{StaticResource TekoFont}" TextFontSize="27"
                       TextFontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            </StackPanel>
            <Border x:Name="moduleTitleDivider" Grid.Row="1" Background="{DynamicResource PanelDividerBrush}"/>
            <ScrollViewer x:Name="listScroll" Grid.Row="2" Margin="0,12,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch" PanningMode="VerticalOnly"><ItemsControl x:Name="shortcutsItems" ItemsSource="{Binding Slots, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:ShortcutsSpanPanel Columns="{Binding GridColumns, RelativeSource={RelativeSource AncestorType={x:Type local:ShortcutsWidget}}}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="5" Background="{DynamicResource ModuleCardSurfaceBrush}" CornerRadius="11" BorderBrush="#35FFFFFF"
                                BorderThickness="1" Cursor="Hand" AllowDrop="True" ContextMenuOpening="SensorContextMenu_Opening" ToolTipService.IsEnabled="{Binding HasToolTip}"
                                Stylus.IsPressAndHoldEnabled="False"
                                PreviewMouseLeftButtonDown="Slot_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="Slot_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="Slot_PreviewMouseLeftButtonUp"
                                PreviewTouchDown="Slot_PreviewTouchDown"
                                PreviewTouchMove="Slot_PreviewTouchMove"
                                PreviewTouchUp="Slot_PreviewTouchUp"
                                DragEnter="Slot_DragEnter" DragOver="Slot_DragEnter" DragLeave="Slot_DragLeave" Drop="Slot_Drop"
                                >
                            <Border.ToolTip><ToolTip Background="#171717" Foreground="#DDD3C1" BorderBrush="#414141" Padding="10,7" Content="{Binding ToolTip}"/></Border.ToolTip><Border.ContextMenu>
                                <ContextMenu Style="{StaticResource MiniContextMenuStyle}" Opened="ShortcutContextMenu_Opened" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Style="{StaticResource MiniMenuItemStyle}" Header="Delete" CommandParameter="{Binding}" Click="RemoveShortcut_Click"/>
                                    <MenuItem Style="{StaticResource MiniMenuItemStyle}" Header="Edit" CommandParameter="{Binding}" Click="EditShortcut_Click"/><MenuItem Style="{StaticResource MiniMenuItemStyle}" Header="Edit macro" CommandParameter="{Binding}" Click="EditMacro_Click"/>
                            <MenuItem Style="{StaticResource MiniMenuItemStyle}" Header="Rename" CommandParameter="{Binding}" Click="RenameShortcut_Click"/>
                                    <MenuItem Style="{StaticResource MiniMenuItemStyle}" Header="Properties" CommandParameter="{Binding}" Click="ShortcutProperties_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <local:MicrophoneMacroFrame Target="{Binding Target}"><Grid><local:SensorTile x:Name="sensorContent" Target="{Binding Target}" Visibility="Collapsed"/><local:AirthingsMini x:Name="airthingsContent" Target="{Binding Target}" Visibility="Collapsed"/><local:UsageMini x:Name="UsageContent" Target="{Binding Target}" Visibility="Collapsed"/><Grid x:Name="tileContent" Margin="5,3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <local:AdaptiveIconImage ShortcutTarget="{Binding Target}" SkinIcon="False" x:Name="ShortcutIcon" Source="{Binding Icon}" Stretch="Uniform" Margin="9,4"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                       UseLayoutRounding="True" SnapsToDevicePixels="True"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="+" Foreground="#A8FFFFFF" FontSize="35"
                                           Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <local:OpticallyCenteredText x:Name="ShortcutTextOnly" Grid.RowSpan="2" Visibility="Collapsed"
                                Text="{Binding Name}" TextBrush="White" TextFontFamily="{Binding MacroTypography.Face, FallbackValue=Segoe UI}" TextFontSize="{Binding MacroTypography.SafeSize, FallbackValue=22}" TextFontWeight="{Binding MacroTypography.Weight, FallbackValue=SemiBold}" TextFontStyle="{Binding MacroTypography.Style, FallbackValue=Normal}" local:LabelTypography.TextEffect="{Binding MacroTypography}" Ellipsis="True" ClipToBounds="True"/>
                            <local:OpticallyCenteredText x:Name="ShortcutName" CompactLineBox="True" Grid.Row="1" Text="{Binding Name}" TextBrush="White" TextFontFamily="{Binding MacroTypography.Face, FallbackValue=Segoe UI}" TextFontSize="{Binding MacroTypography.SafeSize, FallbackValue=18}" TextFontWeight="{Binding MacroTypography.Weight, FallbackValue=SemiBold}" TextFontStyle="{Binding MacroTypography.Style, FallbackValue=Normal}" local:LabelTypography.TextEffect="{Binding MacroTypography}"
                                           Ellipsis="True" ClipToBounds="True"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <local:OpticallyCenteredText.Style><Style TargetType="local:OpticallyCenteredText"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding ShowName}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></local:OpticallyCenteredText.Style>
                                </local:OpticallyCenteredText>
                                <local:OpticallyCenteredText x:Name="ControlLabel" Grid.RowSpan="2"
                                           Text="{Binding ControlDisplay}" Visibility="Collapsed"
                                           TextBrush="{Binding ControlBrush}" TextFontFamily="{Binding ControlFontFamily}"
                                           TextFontSize="{Binding ControlFontSize}" TextFontWeight="{Binding ControlFontWeight}" TextFontStyle="{Binding ControlFontStyle}"
                                           FitToBox="{Binding ClockFit}" Effect="{Binding ClockShadow}" InsetMetalText="{Binding ClockInset}" InsetStrength="{Binding ClockStrength}" InsetOnBrightMetal="False" ClipToBounds="False"
                                           LineAdvance="{Binding ControlLineHeight}"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                <local:ObsTopBarControl x:Name="ObsControlLabel" Grid.RowSpan="2"
                                           Mode="{Binding ObsMode}" Recording="{Binding ObsRecording}"
                                           StatusActive="{Binding ObsStatusActive}" ElapsedText="{Binding ObsElapsedText}"
                                           Visibility="Collapsed"/>
                            </Grid>
                            <local:ListRowContent x:Name="listContent" Visibility="Collapsed" Margin="4">
                                <Grid><local:AdaptiveIconImage ShortcutTarget="{Binding Target}" SkinIcon="False" Source="{Binding Icon}" Stretch="Uniform"/>
                                <local:OpticallyCenteredText x:Name="listPlaceholder" Text="+" TextFontSize="24" Visibility="Collapsed"/>
                                <local:OpticallyCenteredText x:Name="listControl" Text="{Binding ControlDisplay}" TextFontFamily="{Binding ControlFontFamily}" TextFontSize="22" Effect="{Binding ClockShadow}" Visibility="Collapsed"/>
                                </Grid>
                                <local:OpticallyCenteredText x:Name="listName" Text="{Binding Name}" TextBrush="{DynamicResource PanelTextBrush}" TextFontFamily="{Binding MacroTypography.Face, FallbackValue=Segoe UI}" TextFontSize="{Binding MacroTypography.SafeSize, FallbackValue=24}" TextFontWeight="{Binding MacroTypography.Weight, FallbackValue=Normal}" TextFontStyle="{Binding MacroTypography.Style, FallbackValue=Normal}" local:LabelTypography.TextEffect="{Binding MacroTypography}" Ellipsis="True" ClipToBounds="True" InkAlignment="Left"/>
                            </local:ListRowContent>
                            </Grid>
                        </local:MicrophoneMacroFrame></Border>
                        <DataTemplate.Triggers>
                            
                            <DataTrigger Binding="{Binding HasControl}" Value="True">
                                <Setter TargetName="ShortcutIcon" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ShortcutName" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ControlLabel" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsObsControl}" Value="True">
                                <Setter TargetName="ControlLabel" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ObsControlLabel" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShowIcon}" Value="False">
                        <Setter TargetName="ShortcutIcon" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="ShortcutName" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="ShortcutTextOnly" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ShowName}" Value="False">
                                <Setter TargetName="ShortcutIcon" Property="Grid.RowSpan" Value="2"/>
                                <Setter TargetName="ShortcutIcon" Property="Margin" Value="6"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ListMode, RelativeSource={RelativeSource AncestorType={x:Type local:ShortcutsWidget}}}" Value="True"><Setter TargetName="tileContent" Property="Visibility" Value="Collapsed"/><Setter TargetName="listContent" Property="Visibility" Value="Visible"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter TargetName="listPlaceholder" Property="Visibility" Value="Visible"/><Setter TargetName="listName" Property="Visibility" Value="Collapsed"/></DataTrigger>
                            <DataTrigger Binding="{Binding HasControl}" Value="True"><Setter TargetName="listControl" Property="Visibility" Value="Visible"/></DataTrigger>
                        <DataTrigger Binding="{Binding IsSensor}" Value="True"><Setter TargetName="tileContent" Property="Visibility" Value="Collapsed"/><Setter TargetName="listContent" Property="Visibility" Value="Collapsed"/><Setter TargetName="sensorContent" Property="Visibility" Value="Visible"/></DataTrigger>
                        <DataTrigger Binding="{Binding IsAirthingsMini}" Value="True"><Setter TargetName="tileContent" Property="Visibility" Value="Collapsed"/><Setter TargetName="listContent" Property="Visibility" Value="Collapsed"/><Setter TargetName="airthingsContent" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsUsageMini}" Value="True"><Setter TargetName="tileContent" Property="Visibility" Value="Collapsed"/><Setter TargetName="listContent" Property="Visibility" Value="Collapsed"/><Setter TargetName="UsageContent" Property="Visibility" Value="Visible"/></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl></ScrollViewer>
            <Canvas x:Name="dropOverlayCanvas" Grid.Row="2" Margin="0,12,0,0"
                    Panel.ZIndex="20" IsHitTestVisible="False">
                <Border x:Name="clockDropOverlay" Visibility="Collapsed"
                        Background="#371ED760" BorderBrush="#FF1ED760"
                        BorderThickness="2.5" CornerRadius="11"/>
            </Canvas>
        </Grid>
    </Border>
</UserControl>

